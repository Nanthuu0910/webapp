rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.id == userId;
      allow update: if request.auth != null && request.auth.uid == userId && request.resource.data.id == resource.data.id;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // --------------------------------------------------
      // Personalization Recommendations (user-scoped)
      // --------------------------------------------------
      match /personalizationRecommendations/{recommendationId} {
        allow get, list: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.userId == userId;
        allow update: if request.auth != null && request.auth.uid == userId && request.resource.data.userId == resource.data.userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // --------------------------------------------------
      // Messages (user-scoped direct access)
      // --------------------------------------------------
      match /messages/{messageId} {
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.userId == userId;
        allow update, delete: if false;
      }
    }
  }
}
